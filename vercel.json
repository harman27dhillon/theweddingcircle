{
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "crons": [
    {
      "path": "/api/lifecycle",
      "schedule": "0 */12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/wedding-shell-sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/offline.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
